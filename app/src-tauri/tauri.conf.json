{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gh-projects",
  "version": "0.1.0",
  "identifier": "com.ghprojects.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gh-projects",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNUE4NzBCNjZCRDNCNTkKUldSWk83MW1DNGRhSUdTQ3hoLzc3WU9oSVJtYkc4cUdpN3drbU1pWkxhb3NVQ1o0Vks0Nk9ielYK",
      "endpoints": [
        "https://github.com/coconilu/gh-projects/releases/latest/download/latest.json"
      ]
    }
  }
}
